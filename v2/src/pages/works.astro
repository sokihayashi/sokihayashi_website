---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { DOMAINS, STANCES } from '../content.config';
import { wallSrc } from '../data/wall';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const usedDomains = (Object.keys(DOMAINS) as (keyof typeof DOMAINS)[]).filter((k) =>
  works.some((w) => w.data.domain.includes(k))
);
---

<Base title="Works — Soki Hayashi" description="Soki Hayashi(林 宋其)の制作実績。">
  <!-- 枠の文法(黒地に紙色の細い線)。分類はドロップダウン(本人: 分類は必要、ドロップダウンでよい / 立場と並び替えは要らない) -->
  <section class="page-fr" data-frames>
    <div class="fr" data-list>
      <div class="full fr-row" data-frame>
        <span class="fr-lab">Works</span>
        <span class="wk-tools">
          <span class="fr-n" data-count>{works.length}</span>
          <select class="wk-sel" data-domain-select aria-label="分類">
            <option value="all">すべて</option>
            {usedDomains.map((k) => <option value={k}>{DOMAINS[k]}</option>)}
          </select>
        </span>
      </div>
      {
        works.map((w) => (
          <a class="fr-w" data-frame data-domain={w.data.domain.join(' ')} data-stance={w.data.stance} href={`${base}/works/${w.id}/`}>
            <div class="ph">
              {w.data.images[0] && <img src={wallSrc(w.data.images[0], 560)} alt="" loading="lazy" decoding="async" />}
            </div>
            <p class="t">{w.data.title}</p>
            <p class="d">
              {w.data.domain.map((k) => DOMAINS[k]).join(' / ')}
              {w.data.year ? ` — ${w.data.year}` : ''}
            </p>
          </a>
        ))
      }
    </div>
    <!-- 立場(Client / Original)の括りは、本人の判断で外した。消さずに隠してある -->
    <div hidden data-stance-chips>
      {(Object.keys(STANCES) as (keyof typeof STANCES)[]).map((k) => <span>{STANCES[k]}</span>)}
    </div>
  </section>

  <script>
    function initList() {
      const list = document.querySelector<HTMLElement>('[data-list]');
      const sel = document.querySelector<HTMLSelectElement>('[data-domain-select]');
      const count = document.querySelector<HTMLElement>('[data-count]');
      if (!list || !sel || sel.dataset.bound) return;
      sel.dataset.bound = '1';
      const apply = () => {
        const d = sel.value;
        let n = 0;
        list.querySelectorAll<HTMLElement>('[data-domain]').forEach((el) => {
          const ok = d === 'all' || (el.dataset.domain || '').split(' ').includes(d);
          el.hidden = !ok;
          if (ok) n++;
        });
        if (count) count.textContent = String(n);
      };
      sel.addEventListener('change', apply);
    }
    document.addEventListener('astro:page-load', initList);
  </script>
</Base>

<style>
  .wk-tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .wk-sel {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 6px 16px 6px 0;
    background-image: linear-gradient(45deg, transparent 50%, var(--fg) 50%), linear-gradient(135deg, var(--fg) 50%, transparent 50%);
    background-position: right 4px center, right 0 center;
    background-size: 4px 4px, 4px 4px;
    background-repeat: no-repeat;
    cursor: pointer;
  }
  .wk-sel option {
    color: #000;
  }
  .fr-w[hidden] {
    display: none;
  }
</style>
