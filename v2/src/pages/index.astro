---
import Base from '../layouts/Base.astro';
import Vessel from '../components/Vessel.astro';
import { getCollection } from 'astro:content';
import { DOMAINS } from '../content.config';
import { imgRatio } from '../data/img';
import '../styles/stage.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hydraSrc = `${base}/hydra/index.html`;

const all = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
// 中央の列 = 代表の案件。外側の列 = そのほかの案件。1器=1案件。
const featured = all.filter((w) => w.data.featured);
const others = all.filter((w) => !w.data.featured && w.data.images.length > 0);

// 器の大きさ。面積がそろうように、縦横比から幅の係数を決める。
const k = (n?: number) =>
  Math.min(1.2, Math.max(0.72, Math.sqrt((n ? imgRatio(n) : 4 / 3) / (4 / 3)))).toFixed(3);
---

<Base>
  <!--
    価値は最初からある。形だけがない。掬って、器に流し込むと、形になる。

    PC は斜めの軸(data-angle、度。90=縦 / 28=斜め / 0=横)。スマホは真縦。
    JS が動かない環境や「動きを減らす」設定では、このまま縦に読めるページになる。
  -->
  <div class="stage" data-stage-root data-angle="28">
    <iframe
      class="stage-hydra"
      data-hydra
      src={hydraSrc}
      title="Hayashi Design Works — Hydra"
      aria-hidden="true"
      tabindex="-1"
      scrolling="no"
      loading="eager"></iframe>

    <section class="node node-hero" data-node="hero">
      <p class="hero-statement" data-reserve>
        価値は、はじめ<br class="br-s" />液体のように形がない。<br />
        それを掬い、象り、<br />
        あらゆる接点へ流し込む。
      </p>
      <h1 class="hero-name" data-reserve>Soki Hayashi <span>林 宋其</span></h1>
      <p class="stage-cue" data-cue data-reserve aria-hidden="true">Scroll</p>
    </section>

    {
      featured.map((w, i) => (
        <article
          class="node node-work"
          data-node="work"
          data-title={w.data.title}
          style={`--k:${k(w.data.images[0])};--ar:${imgRatio(w.data.images[0] ?? 1).toFixed(4)}`}
        >
          <a class="case" href={`${base}/works/${w.id}/`} draggable="false">
            <Vessel
              n={w.data.images[0]}
              sizes="(max-width: 720px) 90vw, 32vw"
              eager={i < 2}
            />
            <div class="tag">
              <span class="tag-no">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="tag-title">{w.data.title}</h2>
              <p class="tag-sub">{w.data.domain.map((d) => DOMAINS[d]).join(' / ')}</p>
            </div>
          </a>
        </article>
      ))
    }

    <!-- 最後に、空の器がひとつ残っている。 -->
    <section class="node node-end" data-node="end">
      <a class="case case-next" href={`${base}/contact/`} draggable="false">
        <Vessel ratio={4 / 3} />
        <div class="tag">
          <span class="tag-no">{String(featured.length + 1).padStart(2, '0')}</span>
          <h2 class="tag-title">Contact</h2>
        </div>
      </a>
      <p class="end-links">
        <a href={`${base}/works/`}>All works ({all.length})</a>
        <a href={`${base}/about/`}>About</a>
      </p>
    </section>

    <!-- 外側の列(PCのみ)。そのほかの案件。 -->
    {
      others.map((w) => (
        <div class="node node-vessel" data-node="vessel" style={`--k:${k(w.data.images[0])}`}>
          <a class="case" href={`${base}/works/${w.id}/`} draggable="false">
            <Vessel n={w.data.images[0]} />
            <div class="tag">
              <h2 class="tag-title">{w.data.title}</h2>
            </div>
          </a>
        </div>
      ))
    }

    <!-- 飛沫。掬った瞬間に、水滴から器の口へ飛ぶ。 -->
    <div class="beads" data-beads aria-hidden="true"></div>

    <!-- 現在地。スマホでは下端にまとめ、Contact への入口を置く。 -->
    <div class="stage-dock">
      <span class="stage-counter" data-counter aria-hidden="true"></span>
      <a class="dock-cta" href={`${base}/contact/`}>Contact</a>
    </div>
  </div>

  <script>
    import { mountStage } from '../scripts/stage';

    let dispose: (() => void) | undefined;

    function start() {
      dispose?.();
      dispose = undefined;
      const root = document.querySelector<HTMLElement>('[data-stage-root]');
      if (!root) return;
      // 「動きを減らす」設定の人には、ふつうの縦のページのまま見せる。
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      dispose = mountStage(root);
    }

    document.addEventListener('astro:page-load', start);
    document.addEventListener('astro:before-swap', () => {
      dispose?.();
      dispose = undefined;
    });
  </script>
</Base>
