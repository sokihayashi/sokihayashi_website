---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { DOMAINS, STANCES } from '../../content.config';
import { wallSrc } from '../../data/wall';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={`${d.title} — Soki Hayashi`} description={d.summary}>
  <article class="page wrap work">
    <p class="eyebrow" data-reveal><a href={`${base}/works/`}>Works</a></p>
    <h1 class="page-title work-title" data-reveal>{d.title}</h1>

    {
      d.images[0] ? (
        <img class="work-img" src={wallSrc(d.images[0], 1500)} alt={`${d.title} 1`} data-reveal />
      ) : (
        <div class="work-cover" style={`--accent:${d.accent}`} data-reveal aria-hidden="true" />
      )
    }

    <div class="work-cols">
      <dl class="work-meta" data-reveal>
        {
          d.client && (
            <div>
              <dt>Client</dt>
              <dd>{d.client}</dd>
            </div>
          )
        }
        {
          d.year && (
            <div>
              <dt>Year</dt>
              <dd>{d.year}</dd>
            </div>
          )
        }
        {
          d.role.length > 0 && (
            <div>
              <dt>Role</dt>
              <dd>{d.role.join(' / ')}</dd>
            </div>
          )
        }
        <div>
          <dt>Tags</dt>
          <dd>
            {d.domain.map((k) => DOMAINS[k]).join(' / ')} — {STANCES[d.stance]}
          </dd>
        </div>
      </dl>

      <div class="work-text" data-reveal>
        <p class="work-summary">{d.summary}</p>
        <div class="prose"><Content /></div>
        {
          d.url && (
            <p class="work-link-out">
              <a href={d.url} rel="noopener">
                関連リンク →
              </a>
            </p>
          )
        }
        {d.provisional && <p class="work-note">※ このページは仮のデータです。タグと文面は確認前です。</p>}
      </div>
    </div>

    {
      d.images.length > 1 && (
        <div class="work-gallery">
          {d.images.slice(1).map((n, i) => (
            <img
              class="work-img"
              src={wallSrc(n, 1500)}
              alt={`${d.title} ${i + 2}`}
              loading="lazy"
              decoding="async"
              data-reveal
            />
          ))}
        </div>
      )
    }
  </article>
</Base>

<style>
  .eyebrow a {
    border-bottom: 1px solid var(--line);
  }
  .work-title {
    font-size: clamp(2rem, 6vw, 4.4rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .work-cover {
    aspect-ratio: 16 / 9;
    border-radius: 3px;
    background: linear-gradient(150deg, var(--accent), color-mix(in srgb, var(--accent) 45%, #000));
  }
  .work-cols {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(0, 2.4fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    margin-top: clamp(2rem, 6vh, 4rem);
  }
  .work-meta {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    align-content: start;
  }
  .work-meta dt {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .work-meta dd {
    margin: 0.25rem 0 0;
    font-size: 0.92rem;
  }
  .work-summary {
    margin: 0 0 1.5rem;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.7;
  }
  .work-text {
    max-width: 40em;
  }
  .work-link-out a {
    border-bottom: 1px solid var(--muted);
  }
  .work-note {
    margin-top: 2rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .work-cols {
      grid-template-columns: 1fr;
    }
  }
  .work-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  .work-gallery {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin-top: clamp(2.5rem, 7vh, 5rem);
  }
</style>
