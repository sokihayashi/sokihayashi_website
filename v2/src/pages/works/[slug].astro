---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { DOMAINS, STANCES } from '../../content.config';
import { wallSrc } from '../../data/wall';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={`${d.title} — Soki Hayashi`} description={d.summary}>
  <!-- 枠の文法(黒地に紙色の細い線)。中身は、これまでと同じ -->
  <article class="page-fr" data-frames>
    <div class="fr wk">
      <a class="full fr-row fr-link" data-frame href={`${base}/works/`}>
        <span class="fr-lab">Works</span><span class="fr-n">{d.domain.map((k) => DOMAINS[k]).join(' / ')}</span>
      </a>
      <div class="full fr-body" data-frame>
        <h1 class="wk-title">{d.title}</h1>
      </div>
      {
        d.images[0] ? (
          <div class="full wk-img" data-frame>
            <img src={wallSrc(d.images[0], 1500)} alt={`${d.title} 1`} />
          </div>
        ) : null
      }
      {
        (d.client || d.year || d.role.length > 0) && (
          <dl class="full fr-body wk-meta" data-frame>
            {d.client && (<div><dt>Client</dt><dd>{d.client}</dd></div>)}
            {d.year && (<div><dt>Year</dt><dd>{d.year}</dd></div>)}
            {d.role.length > 0 && (<div><dt>Role</dt><dd>{d.role.join(' / ')}</dd></div>)}
          </dl>
        )
      }
      {
        (d.summary || d.url || (work.body ?? '').trim()) && (
          <div class="full fr-body wk-text" data-frame>
            {d.summary && <p class="wk-summary">{d.summary}</p>}
            <div class="prose"><Content /></div>
            {d.url && (<p class="wk-out"><a href={d.url} rel="noopener">関連リンク →</a></p>)}
          </div>
        )
      }
      {
        d.images.slice(1).map((n, i) => (
          <div class="full wk-img" data-frame>
            <img src={wallSrc(n, 1500)} alt={`${d.title} ${i + 2}`} loading="lazy" decoding="async" />
          </div>
        ))
      }
    </div>
    <!-- 立場の表記と「仮のデータです」の注記は、公開の画面に出さない(消さずに隠してある) -->
    <p hidden>{STANCES[d.stance]}{d.provisional && ' ※ このページは仮のデータです。タグと文面は確認前です。'}</p>
  </article>
</Base>

<style>
  .wk-title {
    margin: 0;
    font-size: clamp(1.4rem, 6vw, 2.8rem);
    font-weight: 500;
    line-height: 1.15;
    text-wrap: balance;
  }
  .wk-img {
    padding: 10px;
  }
  .wk-img img {
    display: block;
    width: 100%;
    height: auto;
  }
  .wk-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0;
  }
  .wk-meta dt {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .wk-meta dd {
    margin: 0.3rem 0 0;
    font-size: 0.88rem;
  }
  .wk-summary {
    margin: 0 0 1rem;
    font-size: clamp(0.95rem, 3.4vw, 1.15rem);
    line-height: 1.85;
    max-width: 40em;
  }
  .wk-text .prose {
    max-width: 40em;
  }
  .wk-out a {
    border-bottom: 1px solid var(--muted);
  }
</style>
