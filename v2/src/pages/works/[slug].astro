---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { DOMAINS, STANCES } from '../../content.config';
import Vessel from '../../components/Vessel.astro';
import { imgSize } from '../../data/img';

export async function getStaticPaths() {
  const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: { work, next: works[(i + 1) % works.length] },
  }));
}

const { work, next } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [cover, ...rest] = d.images;
---

<Base title={`${d.title} — Soki Hayashi`} description={d.summary || undefined}>
  <!-- ひと掬いを、画像の数だけの器へ注ぎ分ける。画面に入った器から順に満ちる。 -->
  <article class="work" data-pour-root>
    <header class="work-head wrap">
      <p class="eyebrow"><a href={`${base}/works/`}>Works</a></p>
      <h1 class="work-title">{d.title}</h1>
      {d.summary && <p class="work-summary">{d.summary}</p>}
      <dl class="work-meta">
        {
          d.client && (
            <div>
              <dt>Client</dt>
              <dd>{d.client}</dd>
            </div>
          )
        }
        {
          d.year && (
            <div>
              <dt>Year</dt>
              <dd>{d.year}</dd>
            </div>
          )
        }
        {
          d.role.length > 0 && (
            <div>
              <dt>Role</dt>
              <dd>{d.role.join(' / ')}</dd>
            </div>
          )
        }
        <div>
          <dt>Field</dt>
          <dd>{d.domain.map((k) => DOMAINS[k]).join(' / ')}</dd>
        </div>
        <div>
          <dt>Type</dt>
          <dd>{STANCES[d.stance]}</dd>
        </div>
      </dl>
    </header>

    {
      cover && (
        <figure class="work-cover wrap" data-pour>
          <Vessel n={cover} sizes="(max-width: 1280px) 92vw, 1200px" alt={`${d.title} 1`} eager />
        </figure>
      )
    }

    <div class="work-text wrap">
      <div class="prose"><Content /></div>
      {
        d.url && (
          <p class="work-link-out">
            <a href={d.url} rel="noopener">
              Link →
            </a>
          </p>
        )
      }
    </div>

    {
      rest.length > 0 && (
        <div class="work-gallery wrap">
          {rest.map((n, i) => (
            <figure class={imgSize(n)[0] < imgSize(n)[1] ? 'is-tall' : ''} data-pour>
              <Vessel n={n} sizes="(max-width: 1280px) 92vw, 1200px" alt={`${d.title} ${i + 2}`} />
            </figure>
          ))}
        </div>
      )
    }

    <nav class="work-next wrap" aria-label="次の作品">
      <a href={`${base}/works/${next.id}/`}>
        <span class="eyebrow">Next</span>
        <span class="work-next-title">{next.data.title}</span>
      </a>
      <a class="work-contact" href={`${base}/contact/`}>Contact</a>
    </nav>
  </article>

  <script>
    import { mountPour } from '../../scripts/pour';

    let dispose: (() => void) | undefined;
    document.addEventListener('astro:page-load', () => {
      dispose?.();
      dispose = undefined;
      const root = document.querySelector<HTMLElement>('[data-pour-root]');
      if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      dispose = mountPour(root);
    });
    document.addEventListener('astro:before-swap', () => {
      dispose?.();
      dispose = undefined;
    });
  </script>
</Base>

<style>
  .work {
    padding-top: clamp(7rem, 16vh, 11rem);
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }
  .eyebrow a {
    border-bottom: 1px solid var(--line);
  }
  .work-title {
    margin: 0;
    font-size: clamp(2rem, 6.4vw, 5rem);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .work-summary {
    margin: clamp(1.2rem, 3vh, 2rem) 0 0;
    max-width: 34em;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.8;
    color: rgba(244, 241, 234, 0.86);
  }
  .work-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.5rem, 4vw, 3.5rem);
    margin: clamp(1.6rem, 4vh, 2.6rem) 0 0;
  }
  .work-meta dt {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .work-meta dd {
    margin: 0.25rem 0 0;
    font-size: 0.92rem;
  }
  .work-cover {
    margin-block: clamp(2.5rem, 7vh, 5rem) 0;
  }
  .work-text {
    max-width: calc(40em + var(--pad) * 2);
    margin-block: clamp(2rem, 6vh, 4rem);
  }
  .work-text:not(:has(p)) {
    margin-block: clamp(0.75rem, 2vw, 1.5rem) 0;
  }
  .work-link-out a {
    border-bottom: 1px solid var(--muted);
  }
  .work-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    align-items: start;
  }
  .work-gallery figure,
  .work-cover {
    margin-inline: auto;
  }
  .work-gallery figure {
    margin: 0;
    grid-column: span 2;
  }
  /* 縦長の画像は、2枚並べる。 */
  .work-gallery figure.is-tall {
    grid-column: span 1;
  }
  .work-next {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(4rem, 12vh, 8rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .work-next a:first-child {
    display: grid;
    gap: 0.6rem;
  }
  .work-next .eyebrow {
    margin: 0;
  }
  .work-next-title {
    font-size: clamp(1.6rem, 5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.15;
  }
  .work-contact {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--fg);
    font-size: 0.86rem;
  }
</style>
