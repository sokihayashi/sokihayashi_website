---
// 試作: 作品が、奥行きを持った粒になって立ち上がり、ほどけて、次の作品に組み直る。
// 奥行きは、作品写真から事前に推定したもの(public/img/depth/)。いまのトップ(/)や /lab/morph/ とは別に置いてある。
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { wallSrc } from '../../data/wall';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft && data.images.length > 0)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Soki Hayashi — splat (試作)">
  <!-- JS や WebGL が動かない環境、「動きを減らす」設定では、作品名の一覧として読める。 -->
  <div class="splat" data-splat-root>
    <canvas class="splat-canvas" data-canvas aria-hidden="true"></canvas>
    <ul class="splat-list">
      {
        works.map((w) => (
          <li>
            <a data-work data-src={wallSrc(w.data.images[0], 560)} data-depth={`${base}/img/depth/${String(w.data.images[0]).padStart(3, '0')}.png`} href={`${base}/works/${w.id}/`}>
              {w.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    import { mountSplat } from '../../scripts/splat';

    let dispose: (() => void) | undefined;
    const off = () => {
      dispose?.();
      dispose = undefined;
      document.documentElement.classList.remove('splat-on');
    };
    document.addEventListener('astro:page-load', () => {
      off();
      const root = document.querySelector<HTMLElement>('[data-splat-root]');
      if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!document.createElement('canvas').getContext('webgl2')) return;
      document.documentElement.classList.add('splat-on');
      root.classList.add('is-live');
      dispose = mountSplat(root);
    });
    document.addEventListener('astro:before-swap', off);
  </script>
</Base>

<style is:global>
  .splat {
    padding: 7rem var(--pad) 4rem;
  }
  .splat-canvas {
    display: none;
  }
  .splat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    font-size: 1.1rem;
  }
  html.splat-on,
  html.splat-on body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  html.splat-on .site-foot {
    display: none;
  }
  .splat.is-live {
    position: fixed;
    inset: 0;
    padding: 0;
    overflow: hidden;
    background: #000;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: crosshair;
  }
  .splat.is-live .splat-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 作品名の一覧は、読み上げとキーボードのために残す(見た目には出さない)。 */
  .splat.is-live .splat-list {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
