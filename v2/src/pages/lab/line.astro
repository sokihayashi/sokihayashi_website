---
// 試作: 1本の線を中心に置く(帯 → パイプ → 線の束 → 3Dデータ)。2Dと3Dを、同じ1本の線のまま行き来する。
// /lab/morph/ と /lab/morph-sharp/ とは別の仕組み。そちらには触れていない。
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Soki Hayashi — line (試作)">
  <div class="line" data-line-root data-base={base}>
    <canvas class="line-canvas" data-canvas aria-hidden="true"></canvas>
  </div>

  <script>
    import { mountLine } from '../../scripts/line';

    let dispose: (() => void) | undefined;
    const off = () => {
      dispose?.();
      dispose = undefined;
      document.documentElement.classList.remove('line-on');
    };
    document.addEventListener('astro:page-load', () => {
      off();
      const root = document.querySelector<HTMLElement>('[data-line-root]');
      if (!root) return;
      if (!document.createElement('canvas').getContext('webgl2')) return;
      document.documentElement.classList.add('line-on');
      dispose = mountLine(root);
    });
    document.addEventListener('astro:before-swap', off);
  </script>
</Base>

<style is:global>
  html.line-on,
  html.line-on body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  html.line-on .site-foot {
    display: none;
  }
  .line {
    position: fixed;
    inset: 0;
    background: #000;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: crosshair;
  }
  .line-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
