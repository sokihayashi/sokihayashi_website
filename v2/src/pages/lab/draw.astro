---
// 試作: 描く。スマホを基準にしたヒーローの案。いまのトップとは別に置いてある。
// ヒーローの役目は、技術とセンスを伝えること。作品をきちんと見せるのは Works 以下の落ち着いたページ。
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { wallSrc } from '../../data/wall';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft && data.images.length > 0)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Soki Hayashi — draw (試作)">
  <!--
    なぞると、軌跡が帯になり、帯の中に作品が順に現れる。紙は28°で流れ続ける。
    JS が動かない環境や「動きを減らす」設定では、作品名の一覧として読める。
  -->
  <div class="draw" data-draw-root>
    <canvas class="draw-canvas" data-canvas aria-hidden="true"></canvas>

    <ul class="draw-list">
      {
        works.map((w) => (
          <li>
            <a data-work data-src={wallSrc(w.data.images[0], 560)} href={`${base}/works/${w.id}/`}>
              {w.data.title}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="draw-label" data-label aria-hidden="true">Soki Hayashi</p>
    <a class="draw-exit" data-keep href={`${base}/works/`}>Works</a>
  </div>

  <script>
    import { mountDraw } from '../../scripts/draw';

    let dispose: (() => void) | undefined;
    document.addEventListener('astro:page-load', () => {
      dispose?.();
      dispose = undefined;
      const root = document.querySelector<HTMLElement>('[data-draw-root]');
      if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      dispose = mountDraw(root);
    });
    document.addEventListener('astro:before-swap', () => {
      dispose?.();
      dispose = undefined;
    });
  </script>
</Base>

<style is:global>
  /* ---- ふつうのページ(JS なし / 動きを減らす設定): 作品名の一覧 ---- */
  .draw {
    padding: 7rem var(--pad) 4rem;
  }
  .draw-canvas,
  .draw-label {
    display: none;
  }
  .draw-list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    font-size: 1.1rem;
  }
  .draw-exit {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.2rem;
    border: 1px solid var(--fg);
    font-size: 0.9rem;
  }

  /* ---- 描く(.is-live) ---- */
  html.draw-on,
  html.draw-on body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  html.draw-on .site-foot {
    display: none;
  }
  .draw.is-live {
    position: fixed;
    inset: 0;
    padding: 0;
    overflow: hidden;
    background: #000;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: crosshair;
  }
  .draw.is-live.is-over {
    cursor: pointer;
  }
  .draw.is-live .draw-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 作品名の一覧は、読み上げとキーボードのために残す(見た目には出さない)。 */
  .draw.is-live .draw-list {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .draw.is-live .draw-label {
    display: block;
    position: absolute;
    left: max(20px, var(--pad));
    right: 8.5rem;
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
    z-index: 5;
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  /* 落ち着いたページへの出口。親指の届く右下に、いつも置いておく。 */
  .draw.is-live .draw-exit {
    position: absolute;
    right: max(20px, var(--pad));
    bottom: calc(0.9rem + env(safe-area-inset-bottom));
    z-index: 6;
    background: #000;
    cursor: pointer;
  }
</style>
