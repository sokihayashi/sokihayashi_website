---
// 試作: 作品の写真を、奥行きを持った 3D ガウシアンの粒にして、指の軌跡で動かす(Spark で描く)。
import Base from '../../layouts/Base.astro';
import depthMeta from '../../../public/img/depth/meta.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ids = ['078', '027', '101', '118', '066', '012', '084', '016'];
const works = ids.map((id) => ({
  id,
  src: `${base}/img/wall/${id}-s.webp`,
  depth: `${base}/img/depth/${id}.png`,
  flat: !!(depthMeta as Record<string, { flat: boolean }>)[id]?.flat,
}));
---

<Base title="Soki Hayashi — gauss (試作)">
  <div class="gauss" data-gauss-root data-works={JSON.stringify(works)}></div>
  <script>
    import { mountGauss } from '../../scripts/gauss';
    let dispose: (() => void) | undefined;
    document.addEventListener('astro:page-load', () => {
      dispose?.();
      const root = document.querySelector<HTMLElement>('[data-gauss-root]');
      if (!root) return;
      dispose = mountGauss(root);
    });
    document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined; });
  </script>
</Base>

<style is:global>
  .gauss { position: fixed; inset: 0; background: #000; }
</style>
