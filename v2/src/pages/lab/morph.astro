---
// 試作: 同じ物質が、姿を変え続ける(帯 → 立体 → 粒子 → 網点 → 帯)。
// 描いた長さで状態が進む。場面は切り替わらない。いまのトップ(/)や /lab/draw/ とは別に置いてある。
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { wallSrc } from '../../data/wall';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft && data.images.length > 0)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Soki Hayashi — morph (試作)">
  <!-- JS や WebGL が動かない環境、「動きを減らす」設定では、作品名の一覧として読める。 -->
  <div class="morph" data-morph-root>
    <canvas class="morph-canvas" data-canvas aria-hidden="true"></canvas>
    <ul class="morph-list">
      {
        works.map((w) => (
          <li>
            <a data-work data-src={wallSrc(w.data.images[0], 560)} href={`${base}/works/${w.id}/`}>
              {w.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    import { mountMorph } from '../../scripts/morph';

    let dispose: (() => void) | undefined;
    const off = () => {
      dispose?.();
      dispose = undefined;
      document.documentElement.classList.remove('morph-on');
    };
    document.addEventListener('astro:page-load', () => {
      off();
      const root = document.querySelector<HTMLElement>('[data-morph-root]');
      if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!document.createElement('canvas').getContext('webgl2')) return;
      document.documentElement.classList.add('morph-on');
      root.classList.add('is-live');
      dispose = mountMorph(root);
    });
    document.addEventListener('astro:before-swap', off);
  </script>
</Base>

<style is:global>
  .morph {
    padding: 7rem var(--pad) 4rem;
  }
  .morph-canvas {
    display: none;
  }
  .morph-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    font-size: 1.1rem;
  }
  html.morph-on,
  html.morph-on body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  html.morph-on .site-foot {
    display: none;
  }
  .morph.is-live {
    position: fixed;
    inset: 0;
    padding: 0;
    overflow: hidden;
    background: #000;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: crosshair;
  }
  .morph.is-live .morph-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 作品名の一覧は、読み上げとキーボードのために残す(見た目には出さない)。 */
  .morph.is-live .morph-list {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
