---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Soki Hayashi — Designer',
  description = 'ブランディング、グラフィック、写真、映像、3D、UI/UXを横断するデザイナー、林 宋其(Soki Hayashi)のポートフォリオ。',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// base を考慮したリンク生成 + 現在地判定
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/');
const nav = [
  { href: '/works', label: 'Works' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Soki Hayashi',
  alternateName: '林 宋其',
  jobTitle: 'Designer / Creative Director',
  url: Astro.site?.href,
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/logo.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!-- 書体(仮): 見出しの和文=明朝、本文の和文=ゴシック。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />

    <!-- ページ間をリロードなしで滑らかに繋ぐ -->
    <ClientRouter />
  </head>
  <body>
    <!-- 固定ヘッダー(全ページ共通・遷移で保持) -->
    <header class="site-bar" transition:persist="bar">
      <a class="logo" href={`${base}/`} aria-label="Soki Hayashi — Home">
        <img
          src={`${base}/logo.svg`}
          alt="Hayashi Design Works"
          width="36"
          height="36"
        />
      </a>
      <div class="bar-right">
        <span class="clock" id="clock" aria-hidden="true"></span>
        <nav class="mainnav">
          {
            nav.map((n) => (
              <a
                href={`${base}${n.href}`}
                aria-current={path === n.href ? 'page' : undefined}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main transition:animate="fade">
      <slot />
    </main>

    <footer class="site-foot" transition:persist="foot">
      <span>© {new Date().getFullYear()} Soki Hayashi</span>
      <address>
        Branding / Graphic / Photo / Movie / 3D / UIUX<br />
        Based in Tokyo
      </address>
    </footer>

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      // Lenis はふつうのページでだけ使う。
      // トップ(斜めスクロールのステージ)は自前でスクロールを握るので、そこでは止める。
      let tickerBound = false;
      function syncLenis() {
        const onStage = !!document.querySelector('[data-stage-root]');
        const w = window as any;
        if (reduce || onStage) {
          if (w.__lenis) {
            w.__lenis.destroy();
            w.__lenis = undefined;
          }
          return;
        }
        gsap.registerPlugin(ScrollTrigger);
        if (!w.__lenis) {
          const lenis = new Lenis({ lerp: 0.1 });
          w.__lenis = lenis;
          lenis.on('scroll', ScrollTrigger.update);
        }
        if (!tickerBound) {
          tickerBound = true;
          gsap.ticker.add((t) => (window as any).__lenis?.raf(t * 1000));
          gsap.ticker.lagSmoothing(0);
        }
      }

      // reveal は遷移のたびに作り直す
      function setupReveals() {
        if (reduce) {
          document
            .querySelectorAll<HTMLElement>('[data-reveal]')
            .forEach((el) => (el.style.opacity = '1'));
          return;
        }
        gsap.registerPlugin(ScrollTrigger);
        ScrollTrigger.getAll().forEach((t) => t.kill());
        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
          gsap.from(el, {
            y: 40,
            autoAlpha: 0,
            duration: 1,
            ease: 'power3.out',
            scrollTrigger: { trigger: el, start: 'top 85%' },
          });
        });
        ScrollTrigger.refresh();
      }

      // ライブ時刻(ii-inc的なHUDの一手)
      function startClock() {
        const el = document.getElementById('clock');
        if (!el) return;
        const p = (n: number) => String(n).padStart(2, '0');
        const tick = () => {
          const d = new Date();
          el.textContent =
            `${d.getFullYear()}.${p(d.getMonth() + 1)}.${p(d.getDate())} ` +
            `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())} JST`;
        };
        tick();
        if ((window as any).__clock) clearInterval((window as any).__clock);
        (window as any).__clock = window.setInterval(tick, 1000);
      }

      function onLoad() {
        syncLenis();
        setupReveals();
        startClock();
        const l = (window as any).__lenis;
        if (l) l.scrollTo(0, { immediate: true });
      }

      // 初回ロード + View Transitions のたびに走る
      document.addEventListener('astro:page-load', onLoad);
    </script>
  </body>
</html>
