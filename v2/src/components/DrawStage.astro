---
// 「描く」ヒーローの舞台。試作ページ(/lab/draw/, /lab/gum/)で共有する。
import { getCollection } from 'astro:content';
import { wallSrc } from '../data/wall';

interface Props {
  gum?: boolean; // 描く帯もゴムにする版
}
const { gum = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft && data.images.length > 0)).sort(
  (a, b) => a.data.order - b.data.order
);
---

  <!--
    なぞると、軌跡が帯になり、帯の中に作品が順に現れる。紙は28°で流れ続ける。
    JS が動かない環境や「動きを減らす」設定では、作品名の一覧として読める。
  -->
  <div class="draw" data-draw-root data-gum={gum ? '' : undefined}>
    <canvas class="draw-canvas" data-canvas aria-hidden="true"></canvas>

    <ul class="draw-list">
      {
        works.map((w) => (
          <li>
            <a
              data-work
              data-src={wallSrc(w.data.images[0], 560)}
              data-large={wallSrc(w.data.images[0], 1500)}
              href={`${base}/works/${w.id}/`}
            >
              {w.data.title}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="draw-label" data-label aria-hidden="true">Soki Hayashi</p>
    <!-- ひらいた作品の下に出る、題名と入口。 -->
    <a class="draw-open" data-open data-keep href={`${base}/works/`}></a>
    <!-- 出口: 右下の角から差し込まれた、ゴムのような白い帯。つまんで引くと根の形ごと伸び、離すと太って Works になる。押すだけでも行ける。 -->
    <a class="tape draw-exit" data-keep data-band draggable="false" href={`${base}/works/`}>Works</a>
  </div>

  <script>
    import { mountDraw } from '../scripts/draw';

    let dispose: (() => void) | undefined;
    document.addEventListener('astro:page-load', () => {
      dispose?.();
      dispose = undefined;
      const root = document.querySelector<HTMLElement>('[data-draw-root]');
      if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      dispose = mountDraw(root);
    });
    document.addEventListener('astro:before-swap', () => {
      dispose?.();
      dispose = undefined;
    });
  </script>

<style is:global>
  /* ---- ふつうのページ(JS なし / 動きを減らす設定): 作品名の一覧 ---- */
  .draw {
    padding: 7rem var(--pad) 4rem;
  }
  .draw-canvas,
  .draw-label {
    display: none;
  }
  .draw-list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    font-size: 1.1rem;
  }
  /* ---- 描く(.is-live) ---- */
  html.draw-on,
  html.draw-on body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  html.draw-on .site-foot {
    display: none;
  }
  .draw.is-live {
    position: fixed;
    inset: 0;
    padding: 0;
    overflow: hidden;
    background: #000;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: crosshair;
  }
  .draw.is-live.is-over {
    cursor: pointer;
  }
  .draw.is-live .draw-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 作品名の一覧は、読み上げとキーボードのために残す(見た目には出さない)。 */
  .draw.is-live .draw-list {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .draw.is-live .draw-label {
    display: block;
    position: absolute;
    left: max(20px, var(--pad));
    right: 8.5rem;
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
    z-index: 5;
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .draw-open {
    display: none;
  }
  /* ひらいた作品の題名と入口。作品の左下に付いて、紙と一緒に流れる。 */
  .draw.is-live .draw-open {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    padding: 0.55rem 0.9rem;
    margin-top: -12px;
    background: var(--fg);
    color: #000;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    white-space: pre;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    cursor: pointer;
  }
  .draw.is-live .draw-open.is-on {
    opacity: 1;
    pointer-events: auto;
  }
  /* ひらいているあいだ、左下の題名は消す(作品の下に出ているので)。 */
  .draw.is-live.is-open .draw-label {
    opacity: 0;
  }
  /* 出口の帯は、キャンバスに描く(ゴムのように伸びるので)。
     このリンクは同じ場所に重ねた透明な「つまむところ」で、押すだけでも移動できる。 */
  .draw.is-live .draw-exit {
    position: absolute;
    right: 0;
    bottom: 29px;
    z-index: 6;
    width: 240px;
    padding: 0;
    opacity: 0;
    -webkit-user-drag: none;
    touch-action: none;
    transform-origin: 100% 50%;
    transform: rotate(28deg) translateX(72px);
    cursor: grab;
  }
  .draw.is-live .draw-exit:active {
    cursor: grabbing;
  }
  @media (orientation: portrait) {
    .draw.is-live .draw-exit {
      transform: rotate(62deg) translateX(72px);
    }
  }
</style>
